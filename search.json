---
layout: null
permalink: /search.json
---
[{% for post in site.posts %}
  { "title": {{ post.title | jsonify }}, "url": {{ post.url | relative_url | jsonify }},
    "lang": {{ post.lang | default: site.lang | jsonify }}, "key": {{ post.key | default: post.slug | jsonify }},
    "cat": {{ post.category | jsonify }}, "topic": {{ post.topic | jsonify }}, "tags": {{ post.tags | jsonify }},
    "date": {{ post.date | date: "%Y-%m-%d" | jsonify }}, "stub": {{ post.stub | default: false }}, "cover": {{ post.cover | jsonify }},
    "excerpt": {{ post.excerpt | strip_html | normalize_whitespace | jsonify }},
    "content": {{ post.content | strip_html | normalize_whitespace | jsonify }} }{% unless forloop.last %},{% endunless %}{% endfor %}
]
